{
  "$defs": {
    "EvidenceReceipt": {
      "description": "Audit receipt proving the physical observations and learning history behind an edge or driver.",
      "properties": {
        "arrival_times": {
          "description": "ISO arrival timestamps (enforcing <= issued_at)",
          "items": {
            "type": "string"
          },
          "title": "Arrival Times",
          "type": "array"
        },
        "drift_events": {
          "description": "Recent drift detections touching this edge",
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Drift Events",
          "type": "array"
        },
        "edge_confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Current confidence in EdgeBook",
          "title": "Edge Confidence"
        },
        "edge_first_seen": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO timestamp when edge first appeared in EdgeBook",
          "title": "Edge First Seen"
        },
        "edge_update_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Number of online recursive updates",
          "title": "Edge Update Count"
        },
        "edge_weight": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Current weight in EdgeBook",
          "title": "Edge Weight"
        },
        "node": {
          "description": "Target node receiving the influence",
          "title": "Node",
          "type": "string"
        },
        "observation_ids": {
          "description": "IDs of observations in the ledger within window",
          "items": {
            "type": "string"
          },
          "title": "Observation Ids",
          "type": "array"
        },
        "paired_removal_effect": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Lazy-computed paired removal counterfactual",
          "title": "Paired Removal Effect"
        },
        "parent_node": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Parent node providing the influence",
          "title": "Parent Node"
        },
        "provenance_note": {
          "default": "",
          "description": "Human-readable provenance and simulation disclosure",
          "title": "Provenance Note",
          "type": "string"
        },
        "quality_flags": {
          "description": "Data quality flags (e.g. gated, flatline, late)",
          "items": {
            "type": "string"
          },
          "title": "Quality Flags",
          "type": "array"
        },
        "simulated_parent_flag": {
          "default": false,
          "description": "Explicit flag indicating parent stream is simulated",
          "title": "Simulated Parent Flag",
          "type": "boolean"
        },
        "source_kinds": {
          "description": "Source classification: real | simulated | disaggregated",
          "items": {
            "type": "string"
          },
          "title": "Source Kinds",
          "type": "array"
        },
        "sources": {
          "description": "Sensor/stream source identifiers",
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "trusts": {
          "description": "Source reliability score in [0, 1] at arrival time",
          "items": {
            "type": "number"
          },
          "title": "Trusts",
          "type": "array"
        }
      },
      "required": [
        "node"
      ],
      "title": "EvidenceReceipt",
      "type": "object"
    }
  },
  "description": "An identified causal candidate driver of a risk change.",
  "properties": {
    "ci_lower": {
      "default": 0.0,
      "description": "Bootstrap 95% CI lower bound",
      "title": "Ci Lower",
      "type": "number"
    },
    "ci_upper": {
      "default": 0.0,
      "description": "Bootstrap 95% CI upper bound",
      "title": "Ci Upper",
      "type": "number"
    },
    "contribution": {
      "description": "Estimated contribution to delta stress or delta P(critical)",
      "title": "Contribution",
      "type": "number"
    },
    "direction": {
      "description": "Direction: increases_risk | decreases_risk | neutral",
      "title": "Direction",
      "type": "string"
    },
    "driver_id": {
      "description": "Unique identifier for the candidate driver",
      "title": "Driver Id",
      "type": "string"
    },
    "driver_type": {
      "description": "Type: observation_group | learned_edge | precursor_feature | outlook | uncertainty",
      "title": "Driver Type",
      "type": "string"
    },
    "evidence_receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceReceipt"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Audit receipt behind this driver"
    },
    "label": {
      "description": "Plain-language description using hedged phrasing",
      "title": "Label",
      "type": "string"
    }
  },
  "required": [
    "driver_id",
    "driver_type",
    "contribution",
    "direction",
    "label"
  ],
  "title": "DriverRecord",
  "type": "object"
}