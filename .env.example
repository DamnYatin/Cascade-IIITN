# NASA Earthdata Token for GPM IMERG satellite rainfall
# Register at urs.earthdata.nasa.gov and generate token
EARTHDATA_TOKEN=your_token_here

# Copernicus CDS Key (ERA5-Land hourly precipitation & soil moisture):
# The CDS API key lives in %USERPROFILE%\.cdsapirc (Windows) or ~/.cdsapirc (Linux/macOS):
# url: https://cds.climate.copernicus.eu/api
# key: <your-key>

# Optional Open-Meteo API key (leave blank for free rate-limited tier)
OPENMETEO_API_KEY=
